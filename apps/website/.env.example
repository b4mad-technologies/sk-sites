# Base URL of the published spectator feed (index.json + worlds/<slug>/agent-run-events.jsonl).
# ⚠️ THE PRODUCER IS RETIRED. It was published on triton by
# public-site-publish.mjs, whose timer was deleted from that host on 2026-08-27
# and which is now archived at
# archive/scripts/deploy/player-mcp/public-site-publish.mjs. Phobos has
# no replacement, so the R2 object has not been written since; anything served
# from this URL is stale and is NOT bannered as such (bug: sk-jay0.5.11).
# Unset ⇒ the site serves public/demo-data (sample, and correctly bannered).
VITE_SPELLKAVE_PUBLIC_SITE_URL=

# Account API base (ADR-0107). Seats / claim / release / owner controls.
# Default https://api.spellkave.com; unset in dev falls back to https://mcp.spellkave.com.
# CI / deploy: repo variable SPELLKAVE_API_URL.
VITE_SPELLKAVE_API_URL=

# Deprecated: direct SpacetimeDB play host. Seats no longer use this (Account API).
# VITE_SPELLKAVE_PLAY_URL=ws://127.0.0.1:3000
VITE_SPELLKAVE_PLAY_URL=

# WorkOS AuthKit public SPA client (no secret). Never put WORKOS_API_KEY here.
# CI / production deploy read GitHub repo variables of the same names
# (see .github/workflows/website.yml). Unset client id or issuer ⇒ login UI stays
# hidden (fail closed); there is NO built-in default issuer.
#
# Issuer must be the AuthKit-domain Connect app host (`{issuer}/oauth2/*`), not
# User Management (`api.workos.com/user_management/...`). SpacetimeDB
# Identity = BLAKE3(iss|sub) (ADR-0102 D-2): staging vs production are different
# identity domains. Switching issuer orphans every durable seat claim made under
# the previous iss — see docs/mcp.md §"Production issuer cutover" and
# `just player-mcp-issuer-plan <new-issuer>`.
#
# Staging (demo lane only): https://staging-tenant.authkit.app
# Production: https://<tenant>.authkit.app  OR a custom AuthKit domain
#   (e.g. https://auth.spellkave.com) once the production WorkOS environment exists.
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_ISSUER=https://<tenant>.authkit.app
# VITE_SPELLKAVE_LOGIN_ORIGIN=http://127.0.0.1:18081  # login site for sign-out; no default; required for every non-dev build
