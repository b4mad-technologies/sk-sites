{
	"name": "@spellkave/website",
	"version": "0.0.0",
	"private": true,
	"description": "Public static site for spellkave.com (Cloudflare Worker assets).",
	"type": "module",
	"scripts": {
		"check:metadata-docs": "tsx ./scripts/validate-metadata-docs.mts",
		"dev": "pnpm run check:metadata-docs && node ./scripts/copy-compendium.mjs && vite --host 127.0.0.1",
		"export-compendium": "pnpm run check:metadata-docs && node ./scripts/copy-compendium.mjs --force",
		"build": "pnpm run check:metadata-docs && pnpm run typecheck && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"preview:worker": "pnpm run build && wrangler dev",
		"deploy": "pnpm run build && wrangler deploy",
		"test": "node --test scripts/copy-compendium.test.mjs && vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@spellkave/tool-contracts": "0.1.2",
		"@spellkave/authkit": "workspace:*",
		"@spellkave/run-events-view": "workspace:*",
		"@spellkave/ui": "workspace:*",
		"@spellkave/ui-widgets": "workspace:*",
		"svelte": "^5.46.4"
	},
	"devDependencies": {
		"@spellkave/world-author": "0.1.2",
		"spellkave-validate-wasm": "npm:@spellkave/validate-wasm@0.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.12.4",
		"ajv": "^8.20.0",
		"github-slugger": "^2.0.0",
		"jsdom": "^26.1.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark": "^15.0.1",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-rehype": "^11.1.2",
		"smol-toml": "^1.9.1",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"tsx": "^4.23.1",
		"typescript": "~5.9.3",
		"unist-util-visit": "^5.1.0",
		"vite": "~8.2.4",
		"vitest": "^3.2.6",
		"wrangler": "^4.73.0"
	}
}
