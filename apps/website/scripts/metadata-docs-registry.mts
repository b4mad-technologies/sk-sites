import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { authoringDocMetadata, authoringDocSourcePath, listAuthoringDocs } from "@spellkave/world-author/corpus";
import type { MarkdownDocsRoot } from "../src/compendium/project-authoring-docs.ts";
import type { DocsProjectionRoot } from "../src/compendium/project-metadata-docs.ts";
import { DOCS_ART_ASSETS, DOCS_MODULE_ASSETS } from "./metadata-docs-assets.mjs";

export const WEBSITE_ROOT = dirname(dirname(fileURLToPath(import.meta.url)));
export const REPO_ROOT = resolve(WEBSITE_ROOT, "../..");
const ART_MOUNTS = Object.fromEntries(DOCS_ART_ASSETS.map((asset) => [asset.pathPrefix, asset.publicMount]));
const MODULE_MOUNTS = Object.fromEntries(DOCS_MODULE_ASSETS.map((asset) => [asset.module, { pathPrefix: asset.pathPrefix, publicMount: asset.publicMount }]));

/** Public docs and asset mounts only; all presentation copy remains manifest-authored. */
export const DOCS_PROJECTION_ROOTS: readonly DocsProjectionRoot[] = [
	{
		rootManifestPath: join(REPO_ROOT, "packages/spellkave-srd-cc/fixtures/manifest.toml"),
		mount: "/docs/srd",
		assetMounts: ART_MOUNTS,
	},
	{
		// The shared DM machinery, generated by @spellkave/adventure-runtime and
		// committed under srd-cc's fixtures (ADR-0115 D-3). Mounted one level above
		// the adventures that depend on it, because that is what it is: the part
		// every adventure reuses. Its rows keep the `dm` bundle id they are
		// authored with — a mount is a route, not a rename.
		rootManifestPath: join(REPO_ROOT, "packages/spellkave-srd-cc/fixtures/dm/manifest.toml"),
		mount: "/docs/adventures/runtime",
		dependencyPaths: { srd: join(REPO_ROOT, "packages/spellkave-srd-cc/fixtures/manifest.toml") },
		assetMounts: ART_MOUNTS,
	},
	{
		rootManifestPath: join(REPO_ROOT, "packages/spellkave-adventure-elven-mini/fixtures/adventure.manifest.toml"),
		mount: "/docs/adventures/elven-mini",
		dependencyPaths: {
			srd: join(REPO_ROOT, "packages/spellkave-srd-cc/fixtures/manifest.toml"),
			dm: join(REPO_ROOT, "packages/spellkave-srd-cc/fixtures/dm/manifest.toml"),
		},
		assetMounts: ART_MOUNTS,
		assetModuleMounts: MODULE_MOUNTS,
	},
];

export const DOCS_INDEX_PATH = join(WEBSITE_ROOT, "public/compendium/docs/index.json");

/**
 * Non-manifest documentation roots: a sibling to `DOCS_PROJECTION_ROOTS`, not
 * one of its entries — see `project-authoring-docs.ts`'s own header for why
 * a folder of authored Markdown gets a separate small projector instead of a
 * `DocsProjectionRoot`. World-author's pattern catalog is the first one
 * (sk-jay0.3.5.80: "never copy, always reference" — the SRD bundle used to
 * carry a byte-for-byte copy of these same files).
 */
export const MARKDOWN_DOCS_ROOTS: MarkdownDocsRoot[] = [
	{
		sourceDir: join(REPO_ROOT, "packages/spellkave-world-author/docs/patterns"),
		sourceLabel: "packages/spellkave-world-author/docs/patterns",
		sourceBase: "https://github.com/b4mad-technologies/sk-sdk/blob/main/",
		pageId: "authoring",
		title: "Authoring Patterns",
		navGroup: "reference",
		introDocumentSlug: "index",
		refFamily: "pattern",
		section: {
			id: "patterns",
			title: "Patterns",
			intro:
				"Problem-indexed Spellkave world-authoring patterns: how to compose a non-trivial mechanism from the engine's primitives.",
		},
	},
];

// Build-time projection of the packaged corpus. Stable metadata identities are
// shared with CLI/MCP; existing Patternbook routes remain unchanged.
const publicDocs = listAuthoringDocs().map((doc) => {
	const pattern = doc.id === "patterns" || doc.id.startsWith("patterns/");
	const slug = pattern ? (doc.id === "patterns" ? "index" : doc.id.slice("patterns/".length)) : doc.id.replaceAll("/", "~");
	const metadata = authoringDocMetadata(doc.id);
	if (!metadata) throw new Error(`Missing public doc metadata: ${doc.id}`);
	const supported = metadata.content_status === "implemented";
	const pageId = pattern ? "authoring" : supported ? "guidance" : "guidance-references";
	const sectionId = pattern ? "patterns" : "guides";
	return {
		id: slug, slug, title: doc.title, body: doc.body, metadata,
		sourcePath: doc.source_path ?? `packages/spellkave-world-author/docs/${doc.kind === "example" ? `examples/${doc.id}.md` : authoringDocSourcePath(doc.id)}`,
		pageId, href: `/docs/${pageId}/${sectionId}/${encodeURIComponent(slug)}`,
	};
});
const publishedSources = new Map(publicDocs.map((doc) => [doc.sourcePath, doc.href]));
const patternRoot = MARKDOWN_DOCS_ROOTS[0];
if (!patternRoot) throw new Error("Missing Patternbook registry root");
patternRoot.documents = publicDocs.filter((doc) => doc.pageId === "authoring");
patternRoot.publishedSources = publishedSources;
for (const [pageId, title, introDocumentSlug] of [
	["guidance", "Portable product guidance", "find-an-authoring-pattern"],
	["guidance-references", "Planning and historical guidance references", "hosted-authoring-guidance"],
] as const) {
	MARKDOWN_DOCS_ROOTS.push({
		sourceDir: join(REPO_ROOT, "packages/spellkave-world-author/docs"),
		sourceLabel: "packages/spellkave-world-author/docs", sourceBase: patternRoot.sourceBase,
		pageId, title, introDocumentSlug, navGroup: "reference", refFamily: "guide",
		section: { id: "guides", title, intro: "Package-owned guidance with shared document and corpus identity." },
		documents: publicDocs.filter((doc) => doc.pageId === pageId), publishedSources,
		includeUnsupported: pageId === "guidance-references",
	});
}
