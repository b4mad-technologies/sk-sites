{
	"name": "@spellkave/account",
	"version": "0.0.0",
	"private": true,
	"description": "account.spellkave.com — the signed-in person's keys and identity.",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 5183",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 5183",
