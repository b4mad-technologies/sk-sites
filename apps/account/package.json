		"test": "vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@spellkave/authkit": "workspace:*",
		"@spellkave/ui": "workspace:*",
		"svelte": "^5.46.4"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.12.4",
		"jsdom": "^26.1.0",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.2",
		"typescript": "~5.9.3",
		"vite": "~8.2.4",
		"vitest": "^3.2.6",
		"wrangler": "^4.73.0"
	}
