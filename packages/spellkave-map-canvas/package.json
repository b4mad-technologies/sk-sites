{
	"name": "@spellkave/map-canvas",
	"version": "0.1.0",
	"private": true,
	"description": "The MapLibre world map as a mountable widget: pan/zoom/tap at medium, plus search, floors, place panel and seat marker at full.",
	"license": "PolyForm-Shield-1.0.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/b4mad-technologies/sk-sites.git",
		"directory": "packages/spellkave-map-canvas"
	},
	"type": "module",
	"svelte": "./src/index.ts",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		"./world-assets": "./src/world-assets.ts",
		"./world-artwork": "./src/WorldArtwork.svelte",
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"build": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"maplibre-gl": "^6.4.1"
	},
	"dependencies": {
		"@spellkave/ui": "workspace:*",
		"@spellkave/ui-widgets": "workspace:*",
		"pmtiles": "4.5.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.12.4",
		"jsdom": "^26.1.0",
		"maplibre-gl": "6.4.1",
		"svelte": "^5.46.4",
		"svelte-check": "^4.7.1",
		"typescript": "~5.9.3",
		"vite": "~8.2.4",
		"vitest": "^3.2.6"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
